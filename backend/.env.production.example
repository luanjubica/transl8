# Production Environment Variables
# Copy this to .env.production and fill in real values

# Application
ENVIRONMENT=production
DEBUG=false
APP_NAME=Transl8
API_VERSION=v1
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_STRING

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://transl8:CHANGE_PASSWORD@postgres:5432/transl8
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DB_HOST=postgres
DB_PORT=5432
DB_USER=transl8
DB_PASSWORD=CHANGE_PASSWORD
DB_NAME=transl8

# Redis
REDIS_URL=redis://:CHANGE_PASSWORD@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_PASSWORD

# Clerk Authentication
CLERK_JWT_PUBLIC_KEY=your-production-clerk-jwt-public-key
CLERK_API_KEY=your-production-clerk-api-key

# Translation APIs
DEEPL_API_KEY=your-production-deepl-api-key
OPENAI_API_KEY=your-production-openai-api-key

# File Storage (Cloudflare R2 / AWS S3)
S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=your-production-access-key-id
S3_SECRET_ACCESS_KEY=your-production-secret-access-key
S3_BUCKET_NAME=transl8-production-documents
S3_REGION=auto

# File Upload Limits
MAX_UPLOAD_SIZE=104857600

# Celery
CELERY_BROKER_URL=redis://:CHANGE_PASSWORD@redis:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_PASSWORD@redis:6379/1

# CORS (Add production frontend URL)
CORS_ORIGINS=["https://app.transl8.com","https://www.transl8.com"]
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120

# Monitoring (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
